<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Voters · ECN E-Vote admin</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:400,500,700&amp;display=swap">
  <link href="/assets/css/material-dashboard.css?v=2.1.2" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
</head>
<body data-nav="admin" data-page="voters">
  <a class="skip-link" href="#content">Skip to content</a>
  <nav id="app-shell" aria-label="Main"></nav>
  <script src="/js/shell.js"></script>
  <div class="page">
    <main id="content" class="page-main" tabindex="-1">
      <div id="wallet-status" class="status-panel" role="status" aria-live="polite"></div>
      <header class="page-intro">
        <h1>Voters</h1>
        <p>Wallets registered in the database, and whether the voting contract has them too.</p>
      </header>

      <% if (typeof mismatches != 'undefined' && mismatches.length) { %>
      <div class="alert alert-warning" role="alert">
        <strong>Registered on the blockchain but not saved in the database.</strong>
        Register these voters again, or check the database by hand.
        <ul>
          <% mismatches.forEach(function(m){ %>
          <li><%= m.detail %> (voter reg_id <%= m.actor_reg_id %>, <%= m.created_at %>)</li>
          <% }) %>
        </ul>
      </div>
      <% } %>

      <section class="panel" aria-labelledby="voters-title">
        <h2 id="voters-title">Registered wallets</h2>
        <div class="table-wrap">
          <table class="table table-stack">
            <thead>
              <tr>
                <th scope="col">S.N</th>
                <th scope="col">Account address</th>
                <th scope="col">Is registered</th>
                <th scope="col">On blockchain</th>
              </tr>
            </thead>
            <tbody>
            <% if (userData.length != 0) { var i = 0; userData.forEach(function(data){ %>
              <tr>
                <td data-label="S.N"><%= i %></td>
                <td data-label="Account address"><code><%= data.Account_address %></code></td>
                <td data-label="Is registered"><%= data.Is_registered %></td>
                <td class="on-chain"><%= data.onChain %></td>
              </tr>
            <% i++; }) } else { %>
              <tr><td colspan="4" class="empty-state">No voters have registered yet.</td></tr>
            <% } %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="panel" aria-labelledby="recovery-title">
        <h2 id="recovery-title">Recovery: register an address on-chain</h2>
        <p class="muted">Voters are registered on the blockchain automatically after their email code. Use this only to fix an address the table shows as missing on the blockchain.</p>
        <form data-action="registerVoter">
          <div class="field">
            <label for="accadd">Wallet address</label>
            <input type="text" id="accadd" autocomplete="off" spellcheck="false" required>
          </div>
          <div class="actions">
            <button type="submit" class="btn btn-primary">Register on the blockchain</button>
          </div>
        </form>
      </section>
    </main>
  </div>
  <script src="assets/js/core/jquery.min.js"></script>
  <script src="js/web3.min.js"></script>
  <script src="js/truffle-contract.js"></script>
  <script src="js/templates.js"></script>
  <script src="js/errors.js"></script>
  <script src="js/wallet-status.js"></script>
  <script src="js/steps.js"></script>
  <script src="js/pending.js"></script>
  <script src="js/app.js"></script>
</body>
</html>
