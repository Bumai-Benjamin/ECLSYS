<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Enter your code · ECN E-Vote</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:400,500,700&amp;display=swap">
  <link href="/assets/css/material-dashboard.css?v=2.1.2" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
</head>
<body data-nav="voter" data-page="register">
  <a class="skip-link" href="#content">Skip to content</a>
  <nav id="app-shell" aria-label="Main"></nav>
  <script src="/js/shell.js"></script>
  <div class="page">
    <main id="content" class="page-main" tabindex="-1">
      <section class="panel content-narrow" aria-labelledby="code-title">
        <h1 id="code-title">Check your email</h1>
        <p>We sent a 6-digit code to your email address. It expires in a few minutes.</p>
        <% if (typeof alertMsg != 'undefined' && alertMsg) { %>
          <div class="alert alert-danger" role="alert"><%= alertMsg %></div>
        <% } %>
        <form method="post" action="/otpverify">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <div class="field">
            <label for="otp">Code from the email</label>
            <input type="text" id="otp" name="otp" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required>
          </div>
          <div class="actions">
            <button type="submit" class="btn btn-primary">Confirm code</button>
          </div>
        </form>
      </section>
    </main>
  </div>
</body>
</html>
