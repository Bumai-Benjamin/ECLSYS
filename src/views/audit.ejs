<%
  // Long hex values (addresses, hashes) are shortened; the full value stays in title.
  function isHex(v) { return /^0x[0-9a-fA-F]{20,}$/.test(String(v)); }
  function short(v) { var s = String(v); return s.slice(0, 6) + '…' + s.slice(-4); }
%><!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Election audit · ECN E-Vote</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:400,500,700&amp;display=swap">
  <link href="/assets/css/material-dashboard.css?v=2.1.2" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
</head>
<body data-nav="public" data-page="audit">
  <a class="skip-link" href="#content">Skip to content</a>
  <nav id="app-shell" aria-label="Main"></nav>
  <script src="/js/shell.js"></script>
  <div class="page">
    <main id="content" class="page-main" tabindex="-1">
      <header class="page-intro">
        <h1>Election audit</h1>
        <p>Read directly from the voting contract. Anyone can check these numbers.</p>
      </header>
      <% if (unavailable) { %>
        <div class="alert alert-danger" role="alert"><%= unavailable %></div>
      <% } else { %>
        <section class="panel" aria-labelledby="contract-title">
          <h2 id="contract-title">Contract</h2>
          <p><strong>Address:</strong> <code title="<%= contractAddress %>" tabindex="0"><%= short(contractAddress) %></code></p>
          <p><strong>Phase:</strong> <%= phaseName %></p>
        </section>

        <section class="panel" aria-labelledby="recount-title">
          <h2 id="recount-title">Re-count</h2>
          <p class="muted">The number of vote events for each candidate, counted on this page.</p>
          <div class="table-wrap">
            <table class="table table-stack">
              <thead>
                <tr>
                  <th scope="col">#</th>
                  <th scope="col">Candidate</th>
                  <th scope="col">Re-count</th>
                  <% if (done) { %><th scope="col">Contract total</th><% } %>
                </tr>
              </thead>
              <tbody>
              <% rows.forEach(function (r) { %>
                <tr>
                  <td data-label="#"><%= r.id %></td>
                  <td data-label="Candidate"><%= r.name %></td>
                  <td data-label="Re-count"><%= r.recount %></td>
                  <% if (done) { %><td data-label="Contract total"><%= r.total %></td><% } %>
                </tr>
              <% }) %>
              </tbody>
            </table>
          </div>
          <% if (done) { %>
            <% if (matches) { %>
              <div class="alert alert-success" role="status">Re-count matches the contract totals.</div>
            <% } else { %>
              <div class="alert alert-danger" role="alert">WARNING: re-count does not match the contract totals.</div>
            <% } %>
          <% } else { %>
            <p class="muted">Totals are hidden until voting ends.</p>
          <% } %>
        </section>

        <section class="panel" aria-labelledby="events-title">
          <h2 id="events-title">Events (newest first)</h2>
          <div class="table-wrap">
            <table class="table table-stack">
              <thead>
                <tr><th scope="col">Block</th><th scope="col">Event</th><th scope="col">Details</th></tr>
              </thead>
              <tbody>
              <% events.forEach(function (e) { %>
                <tr>
                  <td data-label="Block"><%= e.blockNumber %></td>
                  <td data-label="Event"><%= e.event %></td>
                  <td data-label="Details"><% Object.keys(e.args).forEach(function (k, i) { var v = e.args[k]; %><%= i ? ', ' : '' %><%= k %>: <% if (isHex(v)) { %><code title="<%= v %>" tabindex="0"><%= short(v) %></code><% } else { %><%= v %><% } %><% }) %></td>
                </tr>
              <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      <% } %>
    </main>
  </div>
</body>
</html>
