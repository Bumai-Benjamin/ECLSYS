<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<title>Login Form</title>
	<link rel="stylesheet" href="css/adminstyle.css">
	<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.6.3/css/all.css">
</head>
<body>
	<div class="center">
	<div class="header">Login Form</div>	

	<%=(typeof alertMsg!='undefined')? alertMsg:''%>

	<form  method="post" action="/adlogin">
		<input type="hidden" name="_csrf" value="<%= csrfToken() %>" />
		<input type="text" placeholder="Email or Username" name="email_address" required/>
		<i class="far fa-envelope"></i>
		<input id="pswrd" type="password" placeholder="Password" name="password" required/>
		<i class="fas fa-lock" id="togglePassword"></i>
		<input type="submit" value="Login">
		<a href="#">Forgot Password?</a>
	</form>
	</div>

	<script src="js/login-page.js"></script>
</body>
</html>