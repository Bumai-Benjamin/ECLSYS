<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Voter registration · ECN E-Vote</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:400,500,700&amp;display=swap">
  <link href="/assets/css/material-dashboard.css?v=2.1.2" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
</head>
<body data-nav="voter" data-page="register">
  <a class="skip-link" href="#content">Skip to content</a>
  <nav id="app-shell" aria-label="Main"></nav>
  <script src="/js/shell.js"></script>
  <div class="page">
    <main id="content" class="page-main" tabindex="-1">
      <div id="wallet-status" class="status-panel" role="status" aria-live="polite"></div>
      <header class="page-intro">
        <h1>Voter registration</h1>
        <p>Register the MetaMask wallet you will vote with. We email you a code to confirm it is you.</p>
      </header>
      <ol id="steps" class="steps" aria-label="Your progress"></ol>
      <% if (typeof alertMsg != 'undefined' && alertMsg) { %>
        <div class="alert <%= /successfully/i.test(alertMsg) ? 'alert-success' : 'alert-danger' %>" role="alert" id="loader"><%= alertMsg %></div>
      <% } %>
      <section class="panel content-narrow" aria-labelledby="reg-title">
        <h2 id="reg-title">Your details</h2>
        <form action="/registerdata" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <div class="field">
            <label for="id_number">Namibian ID number</label>
            <input type="text" id="id_number" name="id_number" inputmode="numeric" autocomplete="off" required>
          </div>
          <div class="field">
            <label for="account_address">Wallet address</label>
            <input type="text" id="account_address" name="account_address" autocomplete="off" spellcheck="false" required>
          </div>
          <div class="actions">
            <button type="submit" class="btn btn-primary">Send me a code</button>
          </div>
        </form>
      </section>
    </main>
  </div>
  <script src="assets/js/core/jquery.min.js"></script>
  <script src="js/web3.min.js"></script>
  <script src="js/truffle-contract.js"></script>
  <script src="js/templates.js"></script>
  <script src="js/errors.js"></script>
  <script src="js/wallet-status.js"></script>
  <script src="js/steps.js"></script>
  <script src="js/pending.js"></script>
  <script src="js/app.js"></script>
</body>
</html>
