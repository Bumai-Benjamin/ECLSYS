# Copy this file to .env and fill in the values. Never commit .env.

# MySQL (XAMPP)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=blockchainvoting

# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# SMTP for OTP emails (Gmail: smtp.gmail.com / 465 with an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Ganache UI workspace
GANACHE_RPC=http://127.0.0.1:7545

# Long random string mixed into OTP hashes
OTP_PEPPER=

# Ganache account keys used by the server (Phase 3 and 4); without 0x is fine
REGISTRAR_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
