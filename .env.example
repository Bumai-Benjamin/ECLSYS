# Copy this file to .env and fill in the values. Never commit .env.

# MySQL (XAMPP)
DB_HOST=localhost
DB_NAME=blockchainvoting
# The app's own least-privilege user (SEC-12). Create it with
# `npm run db:create-user` after setting a password here.
DB_USER=namvoting_app
DB_PASS=
# An account that can create users and change the schema (migrations,
# db:create-user, rebuilding the test database). XAMPP default: root, no password.
DB_ADMIN_USER=root
DB_ADMIN_PASS=

# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# SMTP for OTP emails (Gmail: smtp.gmail.com / 465 with an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Ganache UI workspace
GANACHE_RPC=http://127.0.0.1:7545

# Long random string mixed into OTP hashes
OTP_PEPPER=

# Ganache accounts that `npm run migrate` grants REGISTRAR_ROLE and RELAYER_ROLE.
# Leave empty to use Ganache accounts[1] and accounts[2].
REGISTRAR_ADDRESS=
RELAYER_ADDRESS=

# Ganache account keys used by the server (Phase 3 and 4); without 0x is fine.
# They must belong to REGISTRAR_ADDRESS and RELAYER_ADDRESS (or accounts[1], [2]).
REGISTRAR_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
