{
  "name": "namvoting",
  "version": "1.0.0",
  "description": "NamVoting: blockchain e-voting prototype (Truffle, Ganache, Express, MySQL)",
  "main": "bs-config.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "lite-server -c bs-config.js",
    "start": "lite-server -c bs-config.js",
    "migrate": "truffle migrate --reset",
    "test": "npm run test:api && npm run test:contracts",
    "test:contracts": "truffle test",
    "coverage": "truffle run coverage",
    "test:api": "mocha",
    "db:migrate": "node scripts/db-migrate.js",
    "db:reset-test": "node scripts/db-reset-test.js",
    "db:create-user": "node scripts/create-db-user.js",
    "seed:admin": "node scripts/seed-admin.js"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "chai": "^4.5.0",
    "lite-server": "^2.6.0",
    "mocha": "^10.8.2",
    "solidity-coverage": "0.7.22",
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.19.0",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.6",
    "express": "^4.17.1",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.17.1",
    "get-age": "^1.0.1",
    "helmet": "^8.3.0",
    "md5": "^2.3.0",
    "mysql": "^2.18.1",
    "nodemailer": "latest",
    "nodemon": "^2.0.7",
    "web3": "^4.0.3"
  }
}
